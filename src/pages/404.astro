---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <main
    id="main"
    tabindex="-1"
    class="mx-auto max-w-[980px] px-4 py-24 outline-none sm:px-6"
  >
    <h1 class="text-[clamp(2rem,4vw,2.75rem)] leading-[1.1] font-semibold tracking-[-0.01em]">
      Page not found
    </h1>
    <p class="mt-4 text-text-muted">
      The page you're looking for doesn't exist or has moved.
    </p>
    <p class="mt-6">
      <a href="/">Go to the home page ›</a>
    </p>
  </main>
</BaseLayout>
