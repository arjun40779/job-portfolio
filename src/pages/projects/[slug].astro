---
import { getEntry, render } from "astro:content";
import Container from "../../components/Container.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import FactsRow from "../../components/FactsRow.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import Tag from "../../components/Tag.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { caseStudyHref, getSiteContent, type Project } from "../../lib/content";

interface Props {
  project: Project;
  next: Project | undefined;
}

export async function getStaticPaths() {
  const { caseStudies } = await getSiteContent();
  return caseStudies.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: caseStudies[(i + 1) % caseStudies.length] },
  }));
}

const { project, next } = Astro.props;
const entry = await getEntry("projects", project.id);
if (!entry) throw new Error(`No project entry for "${project.id}"`);
const { Content } = await render(entry);
---

<BaseLayout
  title={project.title}
  description={project.summary}
  ogImage={`/og/projects-${project.id}.png`}
  ogImageAlt={`${project.title} case study by Arjun Singh`}
>
  <article aria-labelledby="case-title" class="pb-8">
    <Container class="pt-10 md:pt-14">
      <div class="flex flex-wrap items-center gap-3 text-meta">
        <a href="/#work" class="hover:underline">
          <span aria-hidden="true">←</span> Back to work
        </a>
        {project.caseStudyDraft && <Tag>Draft</Tag>}
      </div>
      <h1 id="case-title" class="mt-6 text-h2 break-words md:text-display">
        {project.title}
      </h1>
      <p class="mt-4 max-w-[40ch] text-statement text-text-muted">
        {project.summary}
      </p>
    </Container>

    <Container class="mt-10">
      <ProjectMedia
        project={project}
        rounded
        eager
        sizes="(min-width: 980px) 980px, 100vw"
      />
    </Container>

    {project.facts && (
      <Container class="mt-10">
        <FactsRow facts={project.facts} />
      </Container>
    )}

    <Container class="mt-12 grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="case-study md:col-span-8">
        <Content />
      </div>
      <aside
        aria-labelledby="stack-heading"
        class="md:col-span-3 md:col-start-10"
      >
        <h2 id="stack-heading" class="text-meta font-semibold text-text-muted">
          Stack
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))}
        </ul>
        {(project.live || project.code) && (
          <ul class="mt-6 space-y-2 text-meta">
            {project.live && (
              <li>
                <ExternalLink href={project.live}>Visit site</ExternalLink>
              </li>
            )}
            {project.code && (
              <li>
                <ExternalLink href={project.code}>Source code</ExternalLink>
              </li>
            )}
          </ul>
        )}
      </aside>
    </Container>

    <Container class="mt-16">
      <nav
        aria-label="Case studies"
        class="flex flex-col gap-4 border-t border-divider pt-8 sm:flex-row sm:justify-between"
      >
        <a href="/#work" class="hover:underline">
          <span aria-hidden="true">←</span> Back to work
        </a>
        {next && next.id !== project.id && (
          <a href={caseStudyHref(next)} class="hover:underline">
            Next project: {next.title} <span aria-hidden="true">›</span>
          </a>
        )}
      </nav>
    </Container>
  </article>
</BaseLayout>
