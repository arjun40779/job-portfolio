---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteName = "Arjun Singh";
const {
  title,
  description = "Arjun Singh, full-stack engineer building production web applications, from Fastify APIs and PostgreSQL to React interfaces.",
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteName}`
  : `${siteName} · Full-Stack Software Engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#000000"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-full bg-btn-primary px-4 py-2 text-btn-primary-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
