---
import { Icon } from "astro-icon/components";

const options = [
  { value: "system", label: "System", icon: "lucide:monitor" },
  { value: "light", label: "Light", icon: "lucide:sun" },
  { value: "dark", label: "Dark", icon: "lucide:moon" },
] as const;
---

<!-- Hidden until the script runs, so there is never a dead control without JS. -->
<fieldset
  data-theme-toggle
  hidden
  class="m-0 flex min-w-0 items-center gap-0.5 rounded-full border border-control-border p-0.5"
>
  <legend class="sr-only">Theme</legend>
  {options.map(({ value, label, icon }) => (
    <label
      title={label}
      class="relative grid size-7 cursor-pointer place-items-center rounded-full text-text-muted transition-colors duration-200 hover:text-text has-checked:bg-text has-checked:text-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus-ring motion-reduce:transition-none"
    >
      <input type="radio" name="theme" value={value} class="sr-only" />
      <Icon name={icon} class="size-4" aria-hidden="true" />
      <span class="sr-only">{label}</span>
    </label>
  ))}
</fieldset>

<script>
  import { initThemeToggle } from "../scripts/theme";

  initThemeToggle();
</script>
