---
import { getSiteContent } from "../../lib/content";
import { resumeHref } from "../../lib/site";
import Button from "../Button.astro";
import Container from "../Container.astro";
import ExternalLink from "../ExternalLink.astro";
import ProjectMedia from "../ProjectMedia.astro";

const { profile, featured } = await getSiteContent();
// Public work only in the hero until employer images are approved (§4.2).
const heroProject =
  featured.find((p) => p.ownership !== "employer" && !p.draft) ?? featured[0];
---

<section aria-labelledby="hero-heading" class="py-16 md:py-24">
  <Container class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-7">
      {profile.openToWork && (
        <p class="mb-4 flex items-center gap-2 text-meta">
          <span class="size-2 rounded-full bg-success" aria-hidden="true" />
          Open to work
        </p>
      )}
      <h1 id="hero-heading" class="text-display">
        {profile.name}
      </h1>
      <p class="mt-4 max-w-[24ch] text-statement">{profile.statement}</p>
      <p class="mt-3 max-w-[44ch] text-text-muted">{profile.subline}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href="#work">View my work</Button>
        <Button variant="text" href={resumeHref(profile)}>
          Résumé
        </Button>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-meta">
        <li>
          <ExternalLink href={profile.socials.github}>GitHub</ExternalLink>
        </li>
        <li>
          <ExternalLink href={profile.socials.linkedin}>LinkedIn</ExternalLink>
        </li>
        <li>
          <a href={`mailto:${profile.email}`} class="hover:underline">
            Email
          </a>
        </li>
      </ul>
    </div>
    {heroProject && (
      <figure class="md:col-span-5">
        <ProjectMedia
          project={heroProject}
          rounded
          eager
          sizes="(min-width: 980px) 400px, 100vw"
        />
        <figcaption class="mt-3 text-meta text-text-muted">
          {heroProject.title}: {heroProject.summary}
        </figcaption>
      </figure>
    )}
  </Container>
</section>
