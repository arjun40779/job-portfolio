---
import { getSiteContent } from "../../lib/content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import SkillGroup from "../SkillGroup.astro";

const { profile, experience, skills, references } = await getSiteContent();
const current = experience.find((role) => role.end === null);

const facts = [
  { label: "Experience", value: profile.experienceSummary },
  { label: "Location", value: profile.location },
  ...(current
    ? [
        {
          label: "Currently",
          value: [current.company, current.product].filter(Boolean).join(", "),
        },
      ]
    : []),
];
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="border-t border-divider py-16 md:py-24"
>
  <Container>
    <SectionHeading id="about-heading" eyebrow="About">
      A bit about me
    </SectionHeading>

    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <p data-reveal class="max-w-[68ch] md:col-span-7">
        {profile.about}
      </p>
      <dl data-reveal class="space-y-4 md:col-span-4 md:col-start-9">
        {facts.map(({ label, value }) => (
          <div>
            <dt class="text-meta text-text-muted">{label}</dt>
            <dd class="font-medium">{value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <h3 class="mt-16 text-h3">Skills</h3>
    <div data-reveal class="mt-6 grid gap-6 md:grid-cols-3">
      {skills.map((group) => (
        <SkillGroup group={group} references={references} />
      ))}
    </div>
  </Container>
</section>
