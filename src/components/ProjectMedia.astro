---
import { Picture } from "astro:assets";
import type { Project } from "../lib/content";
import PexitArchitecture from "./diagrams/PexitArchitecture.astro";

interface Props {
  project: Project;
  /** Round the corners when the media stands alone (not inside a card). */
  rounded?: boolean;
  sizes?: string;
  /** Above-the-fold media (hero, case study opening): load first. */
  eager?: boolean;
  class?: string;
}

const {
  project,
  rounded = false,
  sizes = "(min-width: 980px) 560px, 100vw",
  eager = false,
  class: className,
} = Astro.props;

const diagrams = { "pexit-architecture": PexitArchitecture };
const Diagram =
  project.showDiagram && project.diagram
    ? diagrams[project.diagram]
    : undefined;
---

{project.showCover && project.cover && project.coverAlt ? (
  <Picture
    src={project.cover}
    alt={project.coverAlt}
    formats={["avif", "webp"]}
    widths={[480, 800, 1200]}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : undefined}
    class:list={[
      "aspect-16/10 w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100",
      rounded && "rounded-card",
      className,
    ]}
  />
) : Diagram ? (
  // Diagrams for private work. Inside a card it is inset like the placeholder.
  <div class:list={[!rounded && "p-3 pb-0", className]}>
    <Diagram class="overflow-hidden rounded-xl border border-divider" />
  </div>
) : (
  // Placeholder until a screenshot or diagram is added. Inside a card it is
  // inset so the card's own shape stays visible on a --surface band.
  <div class:list={[!rounded && "p-3 pb-0", className]}>
    <div class="grid aspect-16/10 w-full place-items-center rounded-xl border border-dashed border-control-border bg-surface p-6 text-center">
      <div>
        <p class="text-h3 text-text-muted">{project.title}</p>
        <p class="mt-1 text-meta text-text-muted">Image coming soon</p>
      </div>
    </div>
  </div>
)}
