---
import { caseStudyHref, type Project } from "../lib/content";
import Button from "./Button.astro";
import Card from "./Card.astro";
import ExternalLink from "./ExternalLink.astro";
import ProjectMedia from "./ProjectMedia.astro";
import Tag from "./Tag.astro";

interface Props {
  project: Project;
  size?: "lg" | "md";
  class?: string;
}

const { project, size = "md", class: className } = Astro.props;
const large = size === "lg";
// Without media (production, nothing approved yet) the text takes the card.
const hasMedia = project.media !== "none";
const split = large && hasMedia;
const titleId = `project-${project.id}-title`;
---

<Card
  as="article"
  tone="bg"
  id={`project-${project.id}`}
  aria-labelledby={titleId}
  class:list={[
    "flex w-full flex-col",
    split && "md:grid md:grid-cols-12",
    className,
  ]}
>
  {hasMedia && (
    <div class:list={[split && "md:col-span-7"]}>
      <ProjectMedia
        project={project}
        class={large ? "md:pb-3" : undefined}
        sizes={
          large
            ? "(min-width: 980px) 572px, 100vw"
            : "(min-width: 768px) 470px, 100vw"
        }
      />
    </div>
  )}
  <div
    class:list={[
      "flex flex-1 flex-col p-6 md:p-8",
      split && "md:col-span-5",
      large && !hasMedia && "md:max-w-[68ch]",
    ]}
  >
    {project.draft && <Tag class="mb-3 self-start">Draft</Tag>}
    <h3 id={titleId} class={large ? "text-h3-lg" : "text-h3"}>
      {project.title}
    </h3>
    <p class="mt-2 text-text-muted">{project.summary}</p>
    <dl class="mt-5 space-y-3 text-meta">
      <div>
        <dt class="font-semibold">What I built</dt>
        <dd class="mt-0.5">{project.contribution}</dd>
      </div>
      <div>
        <dt class="font-semibold">Outcome</dt>
        <dd class="mt-0.5">{project.outcome}</dd>
      </div>
    </dl>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
      {project.tags.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))}
    </ul>
    {(project.caseStudy || project.live || project.code) && (
      <div class="mt-auto flex flex-wrap items-baseline gap-x-6 gap-y-2 pt-6 text-meta">
        {project.caseStudy && (
          <Button variant="text" href={caseStudyHref(project)}>
            Read case study<span class="sr-only"> ({project.title})</span>
          </Button>
        )}
        {project.live && (
          <ExternalLink href={project.live}>
            Visit site<span class="sr-only"> ({project.title})</span>
          </ExternalLink>
        )}
        {project.code && (
          <ExternalLink href={project.code}>
            Code<span class="sr-only"> ({project.title})</span>
          </ExternalLink>
        )}
      </div>
    )}
  </div>
</Card>
